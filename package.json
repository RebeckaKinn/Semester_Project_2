{
  "name": "Semester Project 2",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "npm run tailwind:build && vite build",
    "preview": "vite preview",
    "tailwind:watch": "npx @tailwindcss/cli -i ./src/styles/input.css -o ./src/styles/output.css --watch",
    "tailwind:build": "npx @tailwindcss/cli -i ./src/styles/input.css -o ./src/styles/output.css --minify"
  },
  "devDependencies": {
    "vite": "^8.3.8"
  },
  "dependencies": {
    "@tailwindcss/cli": "^4.3.5",
    "tailwindcss": "^4.3.5"
  }
}
